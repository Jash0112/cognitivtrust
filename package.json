{
  "name": "cognitivtrust",
  "displayName": "cognitivtrust",
  "description": "A security assistant for AI-generated code.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cognitivtrust.showStats",
        "title": "CognitiveTrust: Show Fix Statistics"
      },
      {
        "command": "cognitivtrust.scanWorkspace",
        "title": "CognitiveTrust: Scan Entire Workspace"
      }
    ],
    "configuration": {
      "title": "CognitiveTrust",
      "properties": {
        "cognitivtrust.openai.apiKey": {
          "type": "string",
          "description": "Your API key for the OpenAI API.",
          "default": ""
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.104.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "axios": "^1.12.2"
  }
}